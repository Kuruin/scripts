{
  "manifest_version": 3,
  "name": "Watchlist",
  "description": "A compact watchlist docked inside TradingView that holds up to 1,000 symbols per list. Click a symbol to switch the chart in place.",
  "version": "1.7.0",
  "action": {
    "default_title": "Toggle watchlist (Alt+W)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "Toggle the watchlist"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.tradingview.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.tradingview.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "styles.css",
        "app.js",
        "tv.js",
        "theme-init.js"
      ],
      "matches": [
        "*://*.tradingview.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
